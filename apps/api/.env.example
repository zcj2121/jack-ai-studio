# OpenAI-compatible Provider 的服务端配置
# 复制为 apps/api/.env 后，只在本机填写真实值
# 禁止把真实 API Key 提交到 Git 或发送到浏览器
AI_PROVIDER_API_KEY=

# 留空时使用 OpenAI 官方 API；兼容服务可填写自己的 v1 Base URL
AI_PROVIDER_BASE_URL=

# OpenRouter 使用独立的服务端配置；Base URL 留空时使用官方兼容地址
AI_PROVIDER_OPENROUTER_API_KEY=
AI_PROVIDER_OPENROUTER_BASE_URL=
